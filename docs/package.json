{
  "name": "@gukhanmun/docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "gen:ko-kr": "cargo build --release -p gukhanmun-cli && node scripts/generate-ko-kr.mts",
    "prebuild": "pnpm --filter @gukhanmun/types --filter @gukhanmun/wasm --filter @gukhanmun/stdict-fst --filter @gukhanmun/stdict-cdb --filter @gukhanmun/napi run build && pnpm gen:ko-kr",
    "predev": "pnpm gen:ko-kr",
    "build": "rspress build",
    "dev": "rspress dev",
    "preview": "rspress preview"
  },
  "dependencies": {
    "@gukhanmun/napi": "workspace:*",
    "@gukhanmun/stdict-cdb": "workspace:*",
    "@gukhanmun/stdict-fst": "workspace:*",
    "@gukhanmun/types": "workspace:*",
    "@gukhanmun/wasm": "workspace:*",
    "@plausible-analytics/tracker": "^0.4.5",
    "@rspress/core": "^2.0.12",
    "@rspress/plugin-sitemap": "^2.0.13",
    "@rspress/plugin-twoslash": "^2.0.13",
    "@rspress/plugin-typedoc": "^2.0.13",
    "@types/node": "^22.8.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "dax": "^0.48.1",
    "dompurify": "^3.4.7",
    "marked": "^18.0.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "rspress-plugin-katex": "^1.0.1",
    "rspress-plugin-mermaid": "^1.0.1"
  }
}
