{
  "name": "@gukhanmun/stdict-cdb",
  "version": "0.1.1",
  "description": "Standard Korean Language Dictionary bundled as a CDB binary for @gukhanmun/wasm and @gukhanmun/napi.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./stdict.cdb": "./dist/stdict.cdb"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown && node -e \"require('node:fs').copyFileSync('stdict.cdb','dist/stdict.cdb')\""
  },
  "homepage": "https://github.com/dahlia/gukhanmun",
  "bugs": "https://github.com/dahlia/gukhanmun/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dahlia/gukhanmun.git",
    "directory": "packages/stdict-cdb"
  },
  "license": "GPL-3.0-only",
  "author": {
    "name": "Hong Minhe (洪 民憙)",
    "email": "hong@minhee.org",
    "url": "https://hongminhee.org/"
  },
  "funding": "https://github.com/sponsors/dahlia",
  "engines": {
    "node": ">=20",
    "bun": ">=1.0",
    "deno": ">=2.0"
  },
  "sideEffects": false,
  "keywords": [
    "korean",
    "hanja",
    "hangul",
    "typography",
    "dictionary",
    "cdb"
  ],
  "peerDependencies": {
    "@gukhanmun/types": "*"
  },
  "devDependencies": {
    "@gukhanmun/types": "workspace:*"
  }
}
