{
  "name": "@gukhanmun/loanwords-cdb",
  "version": "0.3.0",
  "description": "NIKL loanword examples bundled as a CDB binary for @gukhanmun/wasm and @gukhanmun/napi.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./loanwords.cdb": "./dist/loanwords.cdb"
  },
  "files": [
    "ATTRIBUTION.md",
    "LICENSE",
    "dist"
  ],
  "scripts": {
    "build": "tsdown && node -e \"require('node:fs').copyFileSync('loanwords.cdb','dist/loanwords.cdb')\"",
    "prebuild": "mise run -C ../.. loanwords-cdb-data"
  },
  "homepage": "https://github.com/dahlia/gukhanmun",
  "bugs": "https://github.com/dahlia/gukhanmun/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dahlia/gukhanmun.git",
    "directory": "packages/loanwords-cdb"
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": {
    "name": "Hong Minhe (洪 民憙)",
    "email": "hong@minhee.org",
    "url": "https://hongminhee.org/"
  },
  "funding": "https://github.com/sponsors/dahlia",
  "engines": {
    "node": ">=20",
    "bun": ">=1.0",
    "deno": ">=2.0"
  },
  "sideEffects": false,
  "keywords": [
    "korean",
    "hanja",
    "hangul",
    "typography",
    "dictionary",
    "cdb"
  ],
  "peerDependencies": {
    "@gukhanmun/types": "*"
  },
  "devDependencies": {
    "@gukhanmun/types": "workspace:*"
  }
}
