{
  "name": "@gukhanmun/wasm",
  "version": "0.1.0",
  "description": "WebAssembly implementation of the Gukhanmun hanja-to-hangul converter.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "deno": "./dist/deno/index.js",
      "browser": "./dist/web/index.js",
      "import": "./dist/web/index.js",
      "require": "./dist/node/index.cjs",
      "default": "./dist/web/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown index.ts --format esm --dts-only --out-dir dist"
  },
  "homepage": "https://github.com/dahlia/gukhanmun",
  "bugs": "https://github.com/dahlia/gukhanmun/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dahlia/gukhanmun.git",
    "directory": "packages/wasm"
  },
  "license": "GPL-3.0-only",
  "author": {
    "name": "Hong Minhe (洪 民憙)",
    "email": "hong@minhee.org",
    "url": "https://hongminhee.org/"
  },
  "funding": "https://github.com/sponsors/dahlia",
  "sideEffects": false,
  "keywords": [
    "korean",
    "hanja",
    "hangul",
    "typography",
    "wasm",
    "webassembly"
  ],
  "peerDependencies": {
    "@gukhanmun/types": "*"
  },
  "devDependencies": {
    "@gukhanmun/types": "workspace:*"
  }
}
