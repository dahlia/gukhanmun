{
  "name": "@gukhanmun/wasm",
  "version": "0.1.0",
  "description": "WebAssembly implementation of the Gukhanmun hanja-to-hangul converter.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown && node -e \"require('node:fs').cpSync('wasm','dist/wasm',{recursive:true,force:true})\""
  },
  "homepage": "https://github.com/dahlia/gukhanmun",
  "bugs": "https://github.com/dahlia/gukhanmun/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dahlia/gukhanmun.git",
    "directory": "packages/wasm"
  },
  "license": "GPL-3.0-only",
  "author": {
    "name": "Hong Minhe (洪 民憙)",
    "email": "hong@minhee.org",
    "url": "https://hongminhee.org/"
  },
  "funding": "https://github.com/sponsors/dahlia",
  "sideEffects": false,
  "keywords": [
    "korean",
    "hanja",
    "hangul",
    "typography",
    "wasm",
    "webassembly"
  ],
  "peerDependencies": {
    "@gukhanmun/types": "*"
  },
  "devDependencies": {
    "@gukhanmun/types": "workspace:*"
  }
}
