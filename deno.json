{
  "workspace": [
    "packages/types",
    "packages/wasm",
    "packages/stdict-fst",
    "packages/stdict-cdb",
    "packages/opendict-fst",
    "packages/opendict-cdb"
  ],
  "nodeModulesDir": "none",
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    },
    "include": [
      "packages/types/",
      "packages/wasm/",
      "packages/stdict-fst/",
      "packages/stdict-cdb/",
      "packages/opendict-fst/",
      "packages/opendict-cdb/",
      "tests/js/"
    ]
  },
  "fmt": {
    "lineWidth": 100,
    "singleQuote": false,
    "include": [
      "docs/",
      "packages/types/",
      "packages/wasm/",
      "packages/stdict-fst/",
      "packages/stdict-cdb/",
      "packages/opendict-fst/",
      "packages/opendict-cdb/",
      "tests/js/"
    ],
    "exclude": [
      "**/*.md"
    ]
  }
}
